# AdScope Environment Variables Configuration

# Server & Runtime
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://adscope:adscope_secret@localhost:5432/adscope_db

# Queue & Cache (Redis)
REDIS_URL=redis://localhost:6379

# AI & LLM Services
ANTHROPIC_API_KEY=mock-anthropic-key-or-live-sk-ant
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=mock-openai-key-or-live-sk-proj
LLM_PROVIDER=mock # Options: 'anthropic', 'openai', 'mock' (default mock for offline/test mode)

# Ad Library APIs (Optional - mock fallbacks available)
META_AD_LIBRARY_ACCESS_TOKEN=
META_AD_LIBRARY_API_VERSION=v21.0
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_BUSINESS_ACCESS_TOKEN=

# Storage (S3 / MinIO / Local)
STORAGE_PROVIDER=local # Options: 'local', 's3'
S3_BUCKET_NAME=adscope-creatives
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Auth & Security
AUTH_SECRET=adscope_super_secure_jwt_secret_change_in_production_32chars
SESSION_MAX_AGE_SECONDS=604800

# Stripe & Billing (Optional for mock test)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook
STRIPE_PRICE_STARTER=price_mock_starter
STRIPE_PRICE_PRO=price_mock_pro
STRIPE_PRICE_AGENCY=price_mock_agency

# Observability & Alerts
LOG_LEVEL=info
SENTRY_DSN=
SLACK_WEBHOOK_URL=
DEFAULT_ALERT_EMAIL=notifications@adscope.internal
